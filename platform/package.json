{
  "name": "northbound-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --disable-warning=ExperimentalWarning --env-file=.env.dev --env-file-if-exists=.env server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/**/*.test.js\"",
    "sync:privacy": "node scripts/sync-privacy.mjs",
    "check:auth": "node --env-file-if-exists=.env scripts/check-auth.mjs",
    "prebuild": "node scripts/sync-privacy.mjs",
    "fly:config": "node scripts/fly-config.mjs",
    "fly": "node scripts/fly.mjs",
    "check-sites": "node scripts/check-sites.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "marked": "^18.1.1",
    "nodemailer": "^10.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
