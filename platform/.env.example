# Copy to .env in this folder (next to package.json). `npm run dev`, `npm start` and `npm run check:auth`
# load it automatically; restart after changing it. Variables set in your shell win over this file.

# Staff sign-in (OpenID Connect: Microsoft Entra ID, Google, Okta...). Redirect URI to register with the
# provider: PUBLIC_URL + /auth/callback. Only the addresses in ADMIN_EMAILS can sign in.
# Google: OIDC_ISSUER=https://accounts.google.com  (client id ends in .apps.googleusercontent.com)
# Microsoft Entra: OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# Then run `npm run check:auth` to verify before trying to sign in.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ADMIN_EMAILS=you@example.com, colleague@example.com
SESSION_SECRET=
# Without the OIDC_* settings above, /admin falls back to this shared token (development and early pilots only).
# When sign-in is configured the token is ignored unless ALLOW_ADMIN_TOKEN=true.
ADMIN_TOKEN=change-me-to-a-long-random-string
PUBLIC_URL=https://onboarding.example.com

# Who is told about new requests (comma-separated). Replies to those emails go to the customer.
NOTIFY_TO=hello@example.com

# "log" prints emails to the console and sends nothing (default, development only: production refuses it).
# "resend" or "postmark" send over HTTPS (use these on Fly.io, which restricts outbound SMTP).
# "smtp" sends over SMTP where the host allows it.
MAIL_TRANSPORT=log
MAIL_FROM=Northbound <onboarding@example.com>
# Where customers' replies to the confirmation go (defaults to MAIL_FROM)
MAIL_REPLY_TO=hello@example.com

# For MAIL_TRANSPORT=resend or postmark: the provider's API key (and your verified sending domain).
MAIL_API_KEY=

# Only for MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
