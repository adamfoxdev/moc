# Copy to .env and run with:  node --env-file=.env server/index.js
# (or export these variables). Nothing here is loaded automatically.

ADMIN_TOKEN=change-me-to-a-long-random-string
PUBLIC_URL=https://onboarding.example.com

# Who is told about new requests (comma-separated). Replies to those emails go to the customer.
NOTIFY_TO=hello@example.com

# "log" prints emails to the console and sends nothing (default). "smtp" sends for real.
MAIL_TRANSPORT=log
MAIL_FROM=Northbound <onboarding@example.com>
# Where customers' replies to the confirmation go (defaults to MAIL_FROM)
MAIL_REPLY_TO=hello@example.com

# Only for MAIL_TRANSPORT=smtp. Example: Microsoft 365 (smtp.office365.com, port 587, STARTTLS)
# or Azure Communication Services Email SMTP (smtp.azurecomm.net, port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
